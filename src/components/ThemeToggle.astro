---
// Renders the icon for the theme you would switch *to*, so the button reads as
// an action rather than a status indicator.
---

<button
  class="theme-toggle"
  type="button"
  aria-label="Switch between light and dark theme"
  title="Switch theme"
>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.currentScript.previousElementSibling;

    const systemDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;

    button.addEventListener('click', () => {
      const current = root.dataset.theme || (systemDark() ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';

      // Once the choice matches the system again, drop the override so the page
      // resumes following the OS if the reader later changes it there.
      if (next === (systemDark() ? 'dark' : 'light')) {
        delete root.dataset.theme;
        localStorage.removeItem('theme');
      } else {
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      }
    });
  })();
</script>
