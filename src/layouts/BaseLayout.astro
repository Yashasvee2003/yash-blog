---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute-ish path used for canonical + og:url. */
  ogType?: 'website' | 'article';
  /** Widen the page to make room for the sticky table of contents. */
  wide?: boolean;
}

const { title, description = '', ogType = 'website', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Posts' },
  { href: '/topics/', label: 'Topics' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Must stay inline, in <head>, and before any stylesheet: it applies the
        stored theme before first paint. Deferring it produces a flash of the
        wrong theme on every navigation. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.remove('no-js');
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') root.dataset.theme = stored;
        } catch {
          /* private mode / storage disabled — fall back to the system preference */
        }
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="yash-blog" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class={wide ? 'layout-wide' : undefined}>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">Yashasvee</a>
        <nav class="site-nav">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>Notes on systems, infrastructure, and machine learning.</span>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
