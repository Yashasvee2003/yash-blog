---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PostNav from '../../components/PostNav.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  // Neighbours run newest -> oldest, so "next" is the older post: the direction
  // you keep reading in, not the direction time runs.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });

// Every post carries an `updated` date, but showing it on the day of publication
// is noise — "01 August 2026 · updated 01 August 2026" tells a reader nothing.
// It appears once the post has actually been revised.
const showUpdated =
  !!post.data.updated && post.data.updated.valueOf() !== post.data.date.valueOf();

// Rough, and deliberately so. Strips LaTeX and image syntax first, since a page
// of KaTeX is not read at prose speed and would badly inflate the count.
const words = post.body
  ? post.body
      .replace(/\$\$[\s\S]*?\$\$/g, ' ')
      .replace(/\$[^$\n]*\$/g, ' ')
      .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
      .replace(/<[^>]+>/g, ' ')
      .split(/\s+/)
      .filter(Boolean).length
  : 0;
const minutes = Math.max(1, Math.round(words / 200));
---

<BaseLayout
  title={`${post.data.title} — Yashasvee`}
  description={post.data.description}
  ogType="article"
>
  <div class="post-layout">
    <article>
      <header class="post-header">
        <a class="post-meta" href={`/topics/${post.data.category}/`}>
          {CATEGORIES[post.data.category]}
        </a>
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {showUpdated && <> · updated {fmt(post.data.updated!)}</>}
          <> · {minutes} min read</>
          {post.data.draft && <> · <strong>draft</strong></>}
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <nav class="tag-row" aria-label="Tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${tag}/`}>
                #{tag}
              </a>
            ))}
          </nav>
        )
      }

      <PostNav prev={prev} next={next} />
    </article>

    <aside class="post-aside">
      <TableOfContents headings={headings} />
    </aside>
  </div>
</BaseLayout>
