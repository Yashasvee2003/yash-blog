---
import { getCollection } from 'astro:content';
import { CATEGORIES, type Category } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const topics = (Object.keys(CATEGORIES) as Category[]).map((category) => ({
  category,
  label: CATEGORIES[category],
  count: posts.filter((p) => p.data.category === category).length,
}));
---

<BaseLayout title="Topics — Yashasvee" description="Browse posts by topic.">
  <h1>Topics</h1>
  <ul class="topic-list">
    {
      topics.map((topic) => (
        <li>
          <a href={`/topics/${topic.category}/`}>{topic.label}</a>
          <span class="post-meta"> · {topic.count} post{topic.count === 1 ? '' : 's'}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
