---
import { getCollection } from 'astro:content';
import { CATEGORIES, type Category } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const topics = (Object.keys(CATEGORIES) as Category[]).map((category) => ({
  category,
  label: CATEGORIES[category],
  count: posts.filter((p) => p.data.category === category).length,
}));

// Categories come from the vault directory, so every post has exactly one.
// Tags cut across them — that is the whole point of having both.
const tags = [...new Set(posts.flatMap((p) => p.data.tags))]
  .map((tag) => ({ tag, count: posts.filter((p) => p.data.tags.includes(tag)).length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---

<BaseLayout title="Topics — Yashasvee" description="Browse posts by topic.">
  <h1>Topics</h1>
  <ul class="topic-list">
    {
      topics.map((topic) => (
        <li>
          <a href={`/topics/${topic.category}/`}>{topic.label}</a>
          <span class="post-meta"> · {topic.count} post{topic.count === 1 ? '' : 's'}</span>
        </li>
      ))
    }
  </ul>

  <h2 class="tags-heading">Tags</h2>
  <p class="post-meta">
    A post has exactly one topic — it comes from where the note lives. Tags cut across them.
  </p>
  <nav class="tag-row tag-cloud" aria-label="All tags">
    {
      tags.map((t) => (
        <a class="tag" href={`/tags/${t.tag}/`}>
          #{t.tag}
          <span class="tag-count">{t.count}</span>
        </a>
      ))
    }
  </nav>
</BaseLayout>
